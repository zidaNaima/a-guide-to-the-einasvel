---
import BaseLayout from "../../layouts/BaseLayout.astro";
const { title, pageLastUpdated } = Astro.props;
---

<BaseLayout title={title} pageLastUpdated={pageLastUpdated}>
    <section slot="header" class="w-full max-w-335 m-auto px-12">
        <h1 class="page-title">The Society | Enausq'/hl/</h1>
        <p class="text-base">
            Learn about the Einasvel culture and the makeup of their anatomy.
            Read about beliefs, clothing, and hunting practices.
        </p>
    </section>

    <section slot="tabs">
        <a href="/society/enausq'hl">Enausq'/hl/</a>
    </section>

    <slot><div class="text-font text-xl text-center">Select a Tab above to get started!</div></slot>
</BaseLayout>