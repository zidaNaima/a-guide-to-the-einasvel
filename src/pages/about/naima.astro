---
import About from "./index.astro";
import formattedDate from "../../scripts/last-updated.ts";
import CharacterAccordion from "../../components/about/CharacterAccordion";
import CommissionExample from "../../components/about/CommissionExample";
import ContactForm from "../../components/ContactForm";
---

<About title="Naima" lastUpdate={formattedDate}>
    <div id="about-the-creator" class="section-header text-font">
        <p>About the Creator</p>
        <hr />
    </div>

    <div id="other-work" class="section-header text-font">
        <p>Other Work</p>
        <hr />
    </div>
    <div class="mb-20">
        <CharacterAccordion client:only />
    </div>

    <div id="commissions" class="section-header text-font">
        <p>Commission Information</p>
        <hr />
    </div>
    <div class="flex flex-wrap flex-col md:flex-row xl:grid xl:grid-cols-[1fr_auto_1fr] gap-6">
        <CommissionExample client:load />

        <div class="sm:min-w-90 m-auto mt-6 xl:mt-0">
            <ContactForm
            text="Lorem ipsum dolor sit, amet consectetur adipisicing elit. Sapiente dolore cumque illum nam?"
            namePlaceholder="Maukkohd"
            contactPlaceholder="maukkohd@einasvel.com"
            messagePlaceholder="De'ih Enausq'/hl/"
            location="Guide V2 | Commissions"
            client:load
            />
        </div>
    </div>
</About>
