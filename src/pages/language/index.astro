---
import BaseLayout from "../../layouts/BaseLayout.astro";
const { title, formattedDate } = Astro.props;
---

<BaseLayout title={title} lastUpdate={formattedDate}>
    <section slot="header" class="w-full max-w-335 m-auto px-12">
        <h1 class="page-title">The Language | Naunoh/hl/oh</h1>
        <p class="text-base">
            Learn about the Naunoh/hl/oh language, listen to its sounds, and
            translate your own sentences.
        </p>
    </section>

    <section slot="tabs">
        <a href="/language/naunohhloh">Naunoh/hl/oh</a>
    </section>

    <slot><div class="text-font text-xl text-center">Select a Tab above to get started!</div></slot>
</BaseLayout>