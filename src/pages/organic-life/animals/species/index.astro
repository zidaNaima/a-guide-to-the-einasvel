---
import Animals from "../index.astro";
import SpeciesList from "../../../../components/life/SpeciesList";
const { title, pageLastUpdated } = Astro.props;
---

<script>
    // script reloads when page is entered
    document.addEventListener("astro:page-load", () => {
        const btn = document.querySelector("#back-button");
        btn?.addEventListener("click", () => {
            window.history.back();
        });
    });
</script>

<Animals title={title} pageLastUpdated={pageLastUpdated}>
    <button
        id="back-button"
        class="text-font border rounded-full w-fit px-6 py-1 mb-6"
    >
        &larr; Go Back
    </button>

    <div class="bg-off-white w-full h-fit p-6 link-on-light underline-link">
        <slot>
            <div class="section-header text-font-secondary">
                <p>Full Species List</p>
                <hr />
                <p class="section-desc">
                    Select an animal species below to get started
                </p>
            </div>
            <SpeciesList client:only />
        </slot>
    </div>
</Animals>
