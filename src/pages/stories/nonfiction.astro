---
import Stories from "./index.astro";
import StorySection from "../../components/stories/StorySection";

import { getLastUpdated } from "../../scripts/page-last-updated";
const pageLastUpdated = getLastUpdated(import.meta.url);
---

<Stories title="Nonfiction" pageLastUpdated={pageLastUpdated}>
    <div id="stories" class="section-header text-font">
        <p>Stories</p>
        <hr />
        <p class="section-desc">
            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Ratione
            tempora laborum rem explicabo voluptates corrupti consectetur
            quibusdam, eius omnis perspiciatis!
        </p>
    </div>

    <StorySection client:only />
</Stories>
